         10.0.12: CVE-2026-84008 (fixed in 9.0.21 / 10.0.13). Remove once SqlClient brings a fixed version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Berrevoets.Monitoring.MigrationService\Berrevoets.Monitoring.MigrationService.csproj" />
    <ProjectReference Include="..\Berrevoets.Monitoring\Berrevoets.Monitoring\Berrevoets.Monitoring.csproj" />
  </ItemGroup>

</Project>
