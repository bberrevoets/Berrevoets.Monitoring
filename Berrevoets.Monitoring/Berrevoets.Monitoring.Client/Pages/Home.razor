@page "/"
@inject MonitoringHubService HubService
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using Berrevoets.Monitoring.Client.Components
@using Berrevoets.Monitoring.Client.Services
@using Berrevoets.Monitoring.Entities.DTO
@using BootstrapIconsForDotNet
@implements IAsyncDisposable 
@rendermode InteractiveWebAssembly

<PageTitle>Health Monitoring Dashboard</PageTitle>

<h1>Health Monitoring Dashboard</h1>

@if (!HubService.IsConnected)
{
    <div class="alert alert-warning">
        <IconComponent Icon="@Icons.ALARM" Size="24"/> Connecting to server...
    </div>
}
else
{
    <div class="alert alert-success">
        <IconComponent Icon="@Icons.CHECK" Size="24"/> Connected to monitoring service
        <p>Display last updated on: @(_lastUpdated.ToLocalTime().ToString("F"))</p>
    </div>
}

@if (_environments.Count == 0)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <p class="text-center mt-2">Loading monitoring data...</p>
}
else
{
    <div class="row">
        @{
            var activeEnvironments = _environments.Where(e => e.IsActive).ToList();
        }

        @if (activeEnvironments.Count == 0)
        {
            <div class="col-md">
                <div class="card h-100">
                    <div class="card-header bg-light">
                        <h4>No Active Environments</h4>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">There are no active environments to display.</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            @foreach (var environment in activeEnvironments)
            {
                <div class="col-md">
                    <div class="card h-100">
                        <div class="card-header bg-light">
                            <h4>@environment.Name</h4>
                        </div>
                        <div class="card-body">
                            @foreach (var application in environment.Applications)
                            {
                                <ApplicationCard Application="application"/>
                            }
                            @if (!environment.Applications.Any())
                            {
                                <p class="text-muted">No Applications in this environment.</p>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        <!-- Last column for external links -->
        <div class="col-md">
            <div class="card h-100">
                <div class="card-header">
                    <h4>Quick Links</h4>
                </div>
                <div class="card-body">
                    <div class="quick-links">
                        <a href="https://example.com" target="_blank" class="btn btn-primary w-100 mb-2">Example Website</a>
                        <a href="https://anotherexample.com" target="_blank" class="btn btn-secondary w-100 mb-2">Another Example</a>
                        <a href="https://yetanotherexample.com" target="_blank" class="btn btn-info w-100">Yet Another Example</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<MonitoredEnvironmentDto> _environments = new();
    private DateTime _lastUpdated = DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to environment updates
        HubService.OnEnvironmentUpdated += HandleEnvironmentUpdated;

        // Connect to the SignalR hub
        await HubService.StartConnectionAsync();

        // Load initial data
        var absoluteUrl = NavigationManager.ToAbsoluteUri("/api/environments").ToString();
        try
        {
            var environments = await Http.GetFromJsonAsync<List<MonitoredEnvironmentDto>>(absoluteUrl);
            if (environments != null)
            {
                // Apply the same ordering as in the server's NotifyClientsAsync method
                foreach (var env in environments)
                {
                    env.Applications = env.Applications
                        .OrderBy(app => GetStatusPriority(app.Status))
                        .ThenBy(app => app.IsActive ? 0 : 1)
                        .ToList();
                }

                // Order environments by OrderNumber
                _environments = environments
                    .OrderBy(env => env.OrderNumber)
                    .ToList();

                HubService.UpdateEnvironments(_environments);
            }
        }
        catch (Exception ex)
        {
            await Console.Error.WriteLineAsync($"Error loading initial data: {ex}");
        }

        await base.OnInitializedAsync();
    }

    // Helper method to determine status priority for sorting
    private int GetStatusPriority(string status)
    {
        return status switch
        {
            "Unhealthy" => 0,
            "Error" => 1,
            "Degraded" => 2,
            "Healthy" => 3,
            _ => 4
        };
    }

    private void HandleEnvironmentUpdated(List<MonitoredEnvironmentDto> environments)
    {
        Console.WriteLine($"HandleEnvironmentUpdated called with {environments.Count} environments");

        _environments = environments;
        _lastUpdated = DateTime.UtcNow;

        // In WebAssembly, we're already on the UI thread, but InvokeAsync ensures it
        InvokeAsync(() =>
        {
            try
            {
                Console.WriteLine("Calling StateHasChanged");
                StateHasChanged();
                Console.WriteLine("StateHasChanged called successfully");
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error in StateHasChanged: {ex}");
            }
        });
    }

    public ValueTask DisposeAsync()
    {
        // Unsubscribe from events when the component is disposed
        HubService.OnEnvironmentUpdated -= HandleEnvironmentUpdated;
        return ValueTask.CompletedTask;
    }

}