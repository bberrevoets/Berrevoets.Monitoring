@page "/"
@inject MonitoringHubService HubService
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using Berrevoets.Monitoring.Client.Components
@using Berrevoets.Monitoring.Client.Services
@using Berrevoets.Monitoring.Entities.DTO
@implements IAsyncDisposable
@rendermode InteractiveWebAssembly

<PageTitle>Health Monitoring Dashboard</PageTitle>

<h1>Health Monitoring Dashboard</h1>

@if (!HubService.IsConnected)
{
    <div class="alert alert-warning">
        <i class="oi oi-warning"></i> Connecting to server...
    </div>
}
else
{
    <div class="alert alert-success">
        <i class="oi oi-check"></i> Connected to monitoring service
        <p>Display last updated on: @(_lastUpdated.ToLocalTime().ToString("F"))</p>
    </div>
}

@if (_environments.Count == 0)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <p class="text-center mt-2">Loading monitoring data...</p>
}
else
{
    <div class="row">
        @foreach (var environment in _environments)
        {
            <div class="col-md-3">
                <div class="card mb-4>">
                    <div class="card-header bg-light">
                        <h4>@environment.Name</h4>
                    </div>
                    <div class="card-body">
                        @foreach (var application in environment.Applications)
                        {
                            <ApplicationCard Application="application"/>
                        }
                        @if (!environment.Applications.Any())
                        {
                            <p class="text-muted">No Applications in this environment.</p>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Last column for external links -->
        <div class="col-md-3 environment-column">
            <div class="card">
                <div class="card-header">
                    <h4>Quick Links</h4>
                </div>
                <div class="card-body">
                    <div class="quick-links">
                        <a href="https://example.com" target="_blank" class="btn btn-primary btn-block mb-2">Example Website</a>
                        <a href="https://anotherexample.com" target="_blank" class="btn btn-secondary btn-block mb-2">Another Example</a>
                        <a href="https://yetanotherexample.com" target="_blank" class="btn btn-info btn-block">Yet Another Example</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private List<MonitoredEnvironmentDto> _environments = new();
    private DateTime _lastUpdated = DateTime.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to environment updates
        HubService.OnEnvironmentUpdated += HandleEnvironmentUpdated;

        // Connect to the SignalR hub
        await HubService.StartConnectionAsync();

        // Load initial data
        var absoluteUrl = NavigationManager.ToAbsoluteUri("/see_all").ToString();
        try
        {
            var environments = await Http.GetFromJsonAsync<List<MonitoredEnvironmentDto>>(absoluteUrl);
            if (environments != null)
            {
                _environments = environments;
                HubService.UpdateEnvironments(environments);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading initial data: {ex}");
        }

        await base.OnInitializedAsync();
    }

    private void HandleEnvironmentUpdated(List<MonitoredEnvironmentDto> environments)
    {
        Console.WriteLine($"HandleEnvironmentUpdated called with {environments.Count} environments");

        _environments = environments;
        _lastUpdated = DateTime.UtcNow;

        // In WebAssembly, we're already on the UI thread, but InvokeAsync ensures it
        InvokeAsync(() =>
        {
            try
            {
                Console.WriteLine("Calling StateHasChanged");
                StateHasChanged();
                Console.WriteLine("StateHasChanged called successfully");
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Error in StateHasChanged: {ex}");
            }
        });
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Healthy" => "bg-success",
            "Unhealthy" => "bg-danger",
            "Degraded" => "bg-warning",
            "Error" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    public async ValueTask DisposeAsync()
    {
        // Unsubscribe from events when the component is disposed
        HubService.OnEnvironmentUpdated -= HandleEnvironmentUpdated;
    }

}