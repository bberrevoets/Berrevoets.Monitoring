@* IconComponent.razor *@
@namespace Berrevoets.Monitoring.Client.Components

@((MarkupString)IconWithSize)

@code {
    [Parameter]
    public string Icon { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 16;

    private string IconWithSize => Icon
        .Replace("width=\"16\" height=\"16\"", $"width=\"{Size}\" height=\"{Size}\"");
}